# Copy to .env and adjust. .env is gitignored.

# Prisma datasource. SQLite for local development.
# For any deployment holding real patient data this must point at a managed,
# encrypted-at-rest database — not a file in the repo.
DATABASE_URL="file:./dev.db"

# HMAC key for the voice-module session cookie. Required in production, minimum
# 32 characters. Generate with: openssl rand -hex 32
# In development an ephemeral key is used, so sessions reset on restart.
VOICE_SESSION_SECRET=""
